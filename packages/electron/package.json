{
  "name": "@openchamber/electron",
  "version": "2.7.2",
  "private": true,
  "description": "Electron desktop runtime for Hao Work",
  "author": "Hao Work contributors; based on OpenChamber by Bohdan Triapitsyn",
  "homepage": "https://github.com/skvdhshuk-blip/hao-work",
  "type": "module",
  "main": "./dist-bundle/entry.mjs",
  "opencodeCli": {
    "version": "2.3.0"
  },
  "dependencies": {
    "@openchamber/web": "workspace:*",
    "electron-context-menu": "^4.1.2",
    "electron-log": "^5.4.3",
    "electron-updater": "^6.8.3",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.2.0",
    "electron": "^45.0.0",
    "electron-builder": "^26.0.0",
    "node-abi": "^4.40.0"
  },
  "trustedDependencies": [
    "electron"
  ],
  "desktopPrerequisites": [
    "Electron runtime dependencies installed via bun install",
    "Bun available for sidecar compilation",
    "macOS: Xcode + build tools for notarized packaging",
    "Windows: NSIS installed for installer creation",
    "Linux: native x64 or arm64 host (no cross-arch packaging); FUSE/libfuse2 to run AppImages, or APPIMAGE_EXTRACT_AND_RUN=1"
  ],
  "scripts": {
    "dev": "bun ../../scripts/build-builtin-extensions.mjs && node ./scripts/electron-dev.mjs",
    "build:web-assets": "node ./scripts/build-web-assets.mjs",
    "build": "bun -e \"process.exit(0)\"",
    "ensure:electron": "node ./scripts/ensure-electron.mjs",
    "prepare:opencode-cli": "node ./scripts/prepare-opencode-cli.mjs",
    "prepare:haocode-runtime": "node ./scripts/prepare-haocode-runtime.mjs",
    "prepare:ripgrep": "node ./scripts/prepare-ripgrep.mjs",
    "verify:opencode-cli": "node ./scripts/verify-opencode-cli.mjs --staged",
    "verify:opencode-cli:packaged": "node ./scripts/verify-opencode-cli.mjs --packaged",
    "verify:linux-appimage": "node ./scripts/verify-linux-appimage.mjs",
    "bundle:main": "bun ./scripts/bundle-main.mjs",
    "generate:macos-icon": "node ./scripts/generate-macos-icon-assets.cjs",
    "rebuild:native": "node ./scripts/rebuild-native.mjs",
    "test": "node ../../scripts/run-isolated-tests.mjs .",
    "test:architecture": "node --test ./startup-url-selection.test.mjs ./menu-locales.test.mjs ./scripts/target-architecture.test.mjs ./scripts/windows-executable.test.mjs ./scripts/verify-linux-appimage.test.mjs ./scripts/verify-update-manifest.test.mjs ./scripts/ensure-electron.test.mjs",
    "test:updater": "node --test ./updater-capability.test.mjs ./updater-channel.test.mjs ./updater-check.test.mjs ./updater-feed.test.mjs ./scripts/finalize-latest-yml.test.mjs ./scripts/updater-e2e-fixture.test.mjs",
    "test:linux-desktop": "node --test ./linux-autostart.test.mjs ./linux-desktop-entry.test.mjs && node ./scripts/smoke-linux-app-discovery.mjs && node ./scripts/smoke-path-open-utils.mjs",
    "updater:e2e:fixture": "node ./scripts/updater-e2e-fixture.mjs",
    "verify:update-manifest": "node ./scripts/verify-update-manifest.mjs",
    "package": "bun run build:web-assets && bun run prepare:haocode-runtime && bun run prepare:ripgrep && bun run bundle:main && bun run rebuild:native && node ./scripts/package.mjs",
    "finalize:latest-yml": "node ./scripts/finalize-latest-yml.mjs",
    "type-check": "node --check ./entry.mjs && node --check ./early-startup.mjs && node --check ./main.mjs && node --check ./preload.mjs && node --check ./browser-panel-preload.cjs",
    "lint": "node -e \"process.exit(0)\""
  },
  "build": {
    "appId": "com.haowork.desktop",
    "productName": "Hao Work",
    "afterPack": "./scripts/after-pack.cjs",
    "asarUnpack": [
      "**/node_modules/@gutenye/**",
      "**/node_modules/onnxruntime-node/**",
      "**/node_modules/onnxruntime-common/**",
      "**/node_modules/onnxruntime-web/**",
      "**/node_modules/@xenova/transformers/**",
      "**/node_modules/@huggingface/jinja/**",
      "**/node_modules/sharp/**",
      "**/node_modules/@img/**",
      "**/node_modules/@techstark/opencv-js/**",
      "**/node_modules/tiny-invariant/**",
      "**/node_modules/js-clipper/**",
      "**/node_modules/adm-zip/**",
      "**/node_modules/global-agent/**",
      "**/node_modules/detect-libc/**",
      "**/node_modules/semver/**",
      "**/node_modules/color/**",
      "**/node_modules/color-convert/**",
      "**/node_modules/color-string/**",
      "**/node_modules/color-name/**",
      "**/node_modules/simple-swizzle/**",
      "**/node_modules/is-arrayish/**",
      "**/node_modules/@openchamber/web/server/lib/haocode/**",
      "node_modules/@openchamber/web/server/built-in-extensions/**/*",
      "node_modules/@openchamber/web/server/lib/git/credential-helper.js",
      "node_modules/@openchamber/web/server/lib/git/ssh-wrapper.js",
      "node_modules/@openchamber/web/server/lib/git/repository-credential-helper.js",
      "**/node_modules/7zip-bin/win/**"
    ],
    "files": [
      "dist-bundle/entry.mjs",
      "dist-bundle/main.mjs",
      "dist-bundle/early-startup.mjs",
      "preload.mjs",
      "browser-panel-preload.cjs",
      "!**/node_modules/**/*.{ts,mts,cts,tsx,map}",
      "!**/node_modules/**/!(LICENSE*|LICENCE*|license*|licence*|License*).md",
      "!**/node_modules/bun-pty{,/**}",
      "!**/node_modules/luxon/{src,build/amd,build/global,build/cjs-browser}{,/**}",
      "!node_modules/@openchamber/web/{dist,src,public,scripts,test}{,/**}",
      "!node_modules/@openchamber/web/*.{html,tgz}",
      "!node_modules/@openchamber/web/{tsconfig.json,tsconfig.tsbuildinfo}",
      "!node_modules/@openchamber/web/server/**/*.test.js",
      "!**/node_modules/7zip-bin/{linux,mac}{,/**}",
      "!**/node_modules/7zip-bin/!(${os})/**/*",
      "!**/node_modules/7zip-bin/win/!(${arch}){,/**}",
      "!node_modules/node-pty/prebuilds/!(${platform}-${arch}){,/**}",
      "!**/node_modules/@vscode/ripgrep-*{,/**}"
    ],
    "extraResources": [
      {
        "from": "resources/web-dist",
        "to": "web-dist"
      },
      {
        "from": "resources/icons/icon.ico",
        "to": "icons/icon.ico"
      },
      {
        "from": "resources/icons/icon.png",
        "to": "icons/icon.png"
      },
      {
        "from": "resources/icons/tray",
        "to": "icons/tray"
      },
      {
        "from": "resources/haocode-runtime",
        "to": "haocode-runtime"
      },
      {
        "from": "resources/ripgrep",
        "to": "ripgrep"
      }
    ],
    "directories": {
      "buildResources": "resources/icons",
      "output": "dist"
    },
    "artifactName": "${productName}-${version}-${arch}.${ext}",
    "npmRebuild": false,
    "mac": {
      "category": "public.app-category.developer-tools",
      "icon": "resources/icons/icon.icns",
      "artifactName": "Hao-Work-${version}-mac-${arch}.${ext}",
      "extendInfo": {
        "CFBundleIconName": "AppIcon",
        "NSLocalNetworkUsageDescription": "Hao Work needs access to devices and services on your local network.",
        "NSAppleEventsUsageDescription": "Lets commands that you or an agent run in Hao Work control other apps."
      },
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "resources/entitlements.mac.plist",
      "entitlementsInherit": "resources/entitlements.mac.plist",
      "notarize": true,
      "target": [
        "dmg",
        "zip"
      ]
    },
    "win": {
      "icon": "resources/icons/icon.ico",
      "target": [
        "nsis"
      ],
      "verifyUpdateCodeSignature": false,
      "artifactName": "Hao-Work-${version}-win-${arch}.${ext}"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb",
        "rpm"
      ],
      "category": "Development",
      "maintainer": "OpenChamber <security@openchamber.dev>",
      "vendor": "Hao Work",
      "synopsis": "Desktop runtime for Hao Work",
      "icon": "resources/icons/app-icon.png",
      "executableName": "hao-work",
      "artifactName": "Hao-Work-${version}-linux-${arch}.${ext}",
      "desktop": {
        "entry": {
          "Name": "Hao Work",
          "Comment": "AI coding workspace powered by HaoCode",
          "Icon": "hao-work",
          "StartupWMClass": "hao-work"
        }
      }
    },
    "deb": {
      "afterInstall": "resources/linux/after-install.tpl",
      "afterRemove": "resources/linux/after-remove.tpl"
    },
    "rpm": {
      "afterInstall": "resources/linux/after-install.tpl",
      "afterRemove": "resources/linux/after-remove.tpl"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "include": "resources/installer.nsh",
      "installerIcon": "resources/icons/icon.ico",
      "uninstallerIcon": "resources/icons/icon.ico",
      "installerHeaderIcon": "resources/icons/icon.ico"
    },
    "dmg": {
      "sign": true,
      "title": "${productName} ${version}",
      "backgroundColor": "#FFFCF0",
      "iconSize": 100,
      "iconTextSize": 13,
      "window": {
        "width": 540,
        "height": 340
      },
      "contents": [
        {
          "x": 180,
          "y": 140,
          "type": "file"
        },
        {
          "x": 360,
          "y": 140,
          "type": "link",
          "path": "/Applications"
        }
      ]
    },
    "publish": {
      "provider": "github",
      "owner": "skvdhshuk-blip",
      "repo": "hao-work"
    }
  }
}
